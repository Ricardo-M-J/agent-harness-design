{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "planner": {
      "description": "规划智能体 — 设计策略师，需求分析与方案制定",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/planner.txt}",
      "temperature": 0.3,
      "steps": 8
    },
    "designer": {
      "description": "设计智能体 — 创意执行者，文案/视觉/页面全流程设计",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/designer.txt}",
      "temperature": 0.7,
      "steps": 10
    },
    "critic": {
      "description": "评估智能体 — 设计评审专家，五维自评审+质量门禁",
      "mode": "subagent",
      "prompt": "{file:.opencode/agents/critic.txt}",
      "temperature": 0.2,
      "steps": 5
    }
  }
}
