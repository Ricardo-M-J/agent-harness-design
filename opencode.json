{
  "$schema": "https://opencode.ai/config.json",
  "model": "boyuerich/gpt-4o",
  "small_model": "boyuerich/gpt-4o-mini",
  "plugin": ["./.opencode/plugins/image-vision.ts"],
  "provider": {
    "boyuerich": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Boyuerich API",
      "options": {
        "baseURL": "https://apicz.boyuerichdata.com/v1",
        "apiKey": "sk-KQRts8IEJesfFj06YYsPXuleWodDxIlZ2t5g2A3DJDk0XRvJ"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-4o-mini": {
          "name": "GPT-4o Mini",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-4.1-mini": {
          "name": "GPT-4.1 Mini",
          "limit": { "context": 128000, "output": 16384 }
        },
        "o3-mini": {
          "name": "o3-mini",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gemini-3-pro-image": {
          "name": "Gemini 3 Pro Image Preview",
          "limit": { "context": 128000, "output": 16384 }
        }
      }
    },
    "moonshot": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Moonshot API",
      "options": {
        "baseURL": "https://api.moonshot.cn/v1",
        "apiKey": "sk-95rL38krsPttv8x96dnuaRqI44T0g3BQ911K9HPB6xAqGbbU"
      },
      "models": {
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "limit": { "context": 256000, "output": 16384 }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": { "context": 256000, "output": 16384 },
          "tools": [{ "type": "builtin_function", "function": { "name": "$web_search" } }]
        }
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "text-to-image": "deny",
        "bash": {
          "*": "deny"
        },
        "edit": {
          "*": "deny"
        }
      }
    },
    "planner": {
      "description": "规划智能体 — 设计策略师，需求分析与方案制定",
      "mode": "subagent",
      "model": "boyuerich/gpt-4.1-mini",
      "prompt": "{file:.opencode/agents/planner.txt}",
      "temperature": 0.3,
      "steps": 8,
      "permission": {
        "edit": {
          "*": "allow"
        },
        "image-vision": "allow",
        "bash": {
          "*": "allow"
        }
      }
    },
    "designer": {
      "description": "设计智能体 — 创意执行者，范式分析+提示词+生图",
      "mode": "subagent",
      "model": "boyuerich/gpt-4o",
      "prompt": "{file:.opencode/agents/designer.txt}",
      "temperature": 0.7,
      "steps": 30,
      "permission": {
        "edit": {
          "*": "allow"
        },
        "text-to-image": "allow",
        "bash": {
          "*": "deny"
        }
      }
    },
    "critic": {
      "description": "评估智能体 — 看图评审+结构化改进建议",
      "mode": "subagent",
      "model": "boyuerich/gpt-4o",
      "prompt": "{file:.opencode/agents/critic.txt}",
      "temperature": 0.2,
      "steps": 30,
      "permission": {
        "edit": {
          "*": "allow"
        },
        "bash": {
          "*": "allow"
        },
        "image-vision": "allow"
      }
    }
  }
}
